# API bearer credentials. Configure only the roles your deployment needs.
# Generate each value independently, for example: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# FA_API_READER_TOKEN=
# FA_API_APPROVER_TOKEN=
# FA_API_EXECUTOR_TOKEN=
# FA_API_AUDITOR_TOKEN=
# FA_API_ADMIN_TOKEN=

# Separate second credential required by the approval gateway. Do not reuse an API token.
# FA_APPROVER_TOKEN=

# Optional hosted-model credentials and routing.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# FA_ANTHROPIC_MODEL=claude-haiku-4-5
# FA_OPENAI_MODEL=gpt-4.1
# FA_ROUTE_REASON=anthropic,openai,deterministic
# FA_ROUTE_RESEARCH=openai,anthropic,deterministic
# FA_ROUTE_REDTEAM=anthropic,deterministic

# Retrieval / safety thresholds.
# FA_TOP_K=8
# FA_MIN_EVIDENCE=1.2
# FA_ACTION_TTL=900
